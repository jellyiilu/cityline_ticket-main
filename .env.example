# 环境变量配置文件示例 (基于参考项目的做法)
# 复制此文件为 .env 并填入真实值

# ===== 验证码服务配置 =====
# Two Captcha API 密钥 (用于自动解决验证码)
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here

# ===== 通知配置 =====
# Webhook通知URL (用于购票成功/失败通知)
NOTIFICATION_WEBHOOK_URL=https://your-webhook-url.com/notify

# 邮件通知配置
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_TO=recipient@example.com

# ===== 用户信息配置 =====
# Cityline账户信息 (用于自动登录)
CITYLINE_EMAIL=your_cityline_email@example.com
CITYLINE_PASSWORD=your_cityline_password

# Facebook账户信息 (备用登录方式)
FACEBOOK_EMAIL=your_facebook_email@example.com  
FACEBOOK_PASSWORD=your_facebook_password

# ===== 高级配置 =====
# Chrome浏览器路径 (如果需要指定特定版本)
CHROME_BINARY_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Chrome用户目录 (用于保留登录和Cloudflare验证后的Cookie)
CHROME_USER_DATA_DIR=artifacts/chrome-profile

# 代理配置 (如果需要使用代理)
PROXY_HTTP=http://proxy.example.com:8080
PROXY_HTTPS=https://proxy.example.com:8080

# ===== 安全配置 =====
# 加密密钥 (用于敏感信息加密存储)
ENCRYPTION_KEY=your_32_character_encryption_key_

# ===== 调试配置 =====
# 开发模式 (true/false)
DEBUG_MODE=false

# 详细日志 (true/false)  
VERBOSE_LOGGING=false

# 保存截图 (true/false)
SAVE_SCREENSHOTS=false

# 非交互模式：运行结束后不等待输入，自动关闭浏览器 (true/false)
NON_INTERACTIVE=false

# ===== 使用说明 =====
# 1. 复制此文件为 .env
# 2. 填入真实的配置值
# 3. 确保 .env 文件被添加到 .gitignore 中
# 4. 重启程序以使环境变量生效

# ===== 安全提醒 =====
# - 请勿将包含真实密钥的 .env 文件提交到代码仓库
# - 定期更换API密钥和密码
# - 使用强密码和双因子认证
